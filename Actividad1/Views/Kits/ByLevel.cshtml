@model IEnumerable<Actividad1.Models.Kit>

@{
    ViewData["Title"] = "Kits By Level";
    var kitsByLevel = Model.GroupBy(k => k.Level);
}

<div class="container mt-5">
    <h1 class="stamped-heading text-center" style="color: var(--color-signal-violet);">B Y   L E V E L</h1>

    @foreach (var group in kitsByLevel)
    {        <h3 class="mt-5 mb-3" style="font-family: 'JetBrains Mono', monospace; font-weight: 400;">
            <span style="color: var(--color-signal-violet);">//</span> @group.Key
        </h3>

        <div class="row g-4 mb-5">
            @foreach (var kit in group)
            {
                <div class="col-md-4">
                    <div class="dope-card">
                        <h5>@kit.Name</h5>
                        <p class="mb-0" style="color: var(--color-steel); font-size: 14px;">@kit.Category</p>
                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <span style="font-family: 'JetBrains Mono', monospace;">$@kit.DailyRate.ToString("F2")</span>
                            <a asp-action="Details" asp-route-id="@kit.Id" class="btn btn-sm btn-dope-outline">Specs</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>