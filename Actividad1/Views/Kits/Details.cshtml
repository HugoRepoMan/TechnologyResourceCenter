@model Actividad1.Models.Kit

@{
    ViewData["Title"] = "Kit Details";
    string statusColor = Model.GetState() == "AVAILABLE" ? "bg-success" : "bg-warning text-dark";
}

<div class="container mt-5">
    <h1 class="stamped-heading text-center">D E T A I L S</h1>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="dope-card p-5" style="border-color: var(--color-almost-white);">
                <h2>@Model.Name <span class="badge bg-secondary ms-2" style="font-size: 14px;">@Model.Level</span></h2>
                <hr style="border-color: rgba(247,249,250,0.2);" />

                <div class="row mb-4">
                    <div class="col-sm-6">
                        <p><strong>Category:</strong> @Model.Category</p>
                        <p><strong>Quantity in Kit:</strong> @Model.Quantity items</p>
                        <p><strong>State:</strong> <span class="badge @statusColor">@Model.GetState()</span></p>
                    </div>
                    <div class="col-sm-6">
                        <p><strong>Daily Rate:</strong> $@Model.DailyRate.ToString("F2")</p>
                        <p><strong>Operational:</strong> @(Model.IsOperational ? "Fully Functional" : "Requires Maintenance")</p>
                    </div>
                </div>
                <div class="p-3 mb-4 rounded" style="background-color: rgba(247,249,250,0.05);">
                    <h5 style="color: var(--color-almost-white);">Estimated Rental Cost</h5>
                    <ul class="list-unstyled mb-0" style="color: var(--color-steel);">
                        <li>1 day: $@Model.CalculateEstimatedCost(1).ToString("F2")</li>
                        <li>7 days (Week): $@Model.CalculateEstimatedCost(7).ToString("F2")</li>
                        <li>14 days: $@Model.CalculateEstimatedCost(14).ToString("F2")</li>
                    </ul>
                </div>

                <div class="d-flex gap-3 mt-4">
                    <a asp-action="Index" class="btn btn-dope-outline">Back to Kits</a>
                    <a asp-action="ByLevel" class="btn btn-dope-outline" style="border-color: var(--color-signal-violet); color: var(--color-signal-violet);">View by Level</a>
                </div>
            </div>
        </div>
    </div>
</div>