@model Actividad1.Models.Accessory

@{
    ViewData["Title"] = "Accessory Details";
    string inventoryColor = Model.GetInventoryStatus() == "IN STOCK" ? "bg-success" : (Model.GetInventoryStatus() == "LOW STOCK" ? "bg-warning text-dark" : "bg-danger");
}

<div class="container mt-5">
    <h1 class="stamped-heading text-center">D E T A I L S</h1>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="dope-card p-5" style="border-color: rgba(247,249,250,0.2);">
                <h2>@Model.Name</h2>
                <hr style="border-color: rgba(247,249,250,0.2);" />

                <div class="row mb-4">
                    <div class="col-sm-6">
                        <p><strong>Brand:</strong> @Model.Brand</p>
                        <p><strong>Category:</strong> @Model.Category</p>
                        <p><strong>Current Stock:</strong> @Model.Quantity units</p>
                    </div>
                    <div class="col-sm-6">
                        <p><strong>Unit Price:</strong> $@Model.Price.ToString("F2")</p>
                        <p><strong>Availability:</strong> <span class="badge @inventoryColor">@Model.GetInventoryStatus()</span></p>
                    </div>
                </div>
                <div class="p-3 mb-4 rounded" style="background-color: rgba(247,249,250,0.05);">
                    <h5 style="color: var(--color-almost-white);">Bulk Pricing Estimation</h5>
                    <ul class="list-unstyled mb-0" style="color: var(--color-steel);">
                        <li>1 unit: $@Model.CalculateBulkCost(1).ToString("F2")</li>
                        <li>5 units: $@Model.CalculateBulkCost(5).ToString("F2")</li>
                        <li>10 units: $@Model.CalculateBulkCost(10).ToString("F2")</li>
                        @if (Model.Quantity < 10)
                        {
                            <li class="mt-2 text-danger" style="font-size: 12px;">* Not enough stock for 10 units.</li>
                        }
                    </ul>
                </div>

                <div class="d-flex gap-3 mt-4">
                    <a asp-action="Index" class="btn btn-dope-outline">Back to Accessories</a>
                    <a asp-action="ByCategory" class="btn btn-dope-outline" style="border-color: var(--color-signal-violet); color: var(--color-signal-violet);">View by Category</a>
                </div>
            </div>
        </div>
    </div>
</div>